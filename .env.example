# Copy this file to .env and fill in ONE key. Never commit .env.

# --- LLM (free tiers) ---
LLM_PROVIDER=groq            # groq or gemini
GROQ_API_KEY=
GEMINI_API_KEY=
# LLM_MODEL=                 # optional override, e.g. llama-3.3-70b-versatile or gemini-2.5-flash

# --- FalkorDB (local Docker defaults) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# For FalkorDB Cloud also set:
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=true
GRAPH_NAME=companybrain
